# Postgres (docker-compose.yml maps host 5434 -> container 5432, to avoid
# colliding with any other local Postgres instance). For local dev there's
# no connection pooler in front of it, so DIRECT_URL can just repeat
# DATABASE_URL — see DEPLOY.md for the split values a hosted Postgres
# (Neon / Vercel Postgres) needs.
DATABASE_URL="postgresql://postgres:pass@localhost:5434/riglog"
DIRECT_URL="postgresql://postgres:pass@localhost:5434/riglog"

# NextAuth
# The full public origin this app is served from — scheme and host, no
# path. Every absolute link the server builds comes from here: password
# reset emails, collaborator invitations, follower and price alerts,
# document reminders, Stripe redirects, the sitemap and public build URLs.
#
# It must be the full origin (https://riglog.ro), NOT a bare hostname and
# NOT a secret. Pasting NEXTAUTH_SECRET in here by mistake produces reset
# links like http://drrisq1f...echq=/reset-password?token=... — the URL
# parser accepts that as a hostname, so it fails silently. src/lib/appUrl.ts
# validates it now and refuses to send rather than mailing a dead link.
#
# On Vercel this can be left unset: VERCEL_PROJECT_PRODUCTION_URL is used
# automatically. Set it explicitly for a custom domain.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth (optional — email/password works without it)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (transactional email — password reset, document reminders, collaborator invites)
# Transactional email. Set ONE of these; Brevo wins if both are set.
# Brevo (brevo.com) supports verifying a single sender address, so it
# works without owning a domain. Resend requires a verified domain.
BREVO_API_KEY=""
RESEND_API_KEY=""
# Must be a sender you have verified with whichever provider you use.
EMAIL_FROM="RigLog <no-reply@riglog.ro>"

# Photo/receipt storage. Local disk (UPLOADS_DIR) is fine for `npm run dev`
# but does NOT work on Vercel (serverless functions don't share a
# filesystem) — set BLOB_READ_WRITE_TOKEN there instead and storage.ts
# automatically switches to Vercel Blob with no code changes. See DEPLOY.md.
UPLOADS_DIR="./public/uploads"
BLOB_READ_WRITE_TOKEN=""

# Secret required (as `x-cron-secret`, or the `Authorization: Bearer`
# header Vercel Cron sends automatically) to call
# POST /api/cron/document-reminders. vercel.json wires up a daily Vercel
# Cron hit against this route when deployed there; elsewhere, point your
# own scheduler (a crontab, GitHub Actions, ...) at it with this secret.
CRON_SECRET="replace-with-a-long-random-string"

# Stripe (RL-017 — Pro subscription/lifetime purchase). Create the three
# Prices in the Stripe dashboard with currency=RON: Monthly (14.99 RON,
# recurring), Annual (99 RON, recurring), Lifetime (299 RON, one-time),
# and paste each Price ID below. STRIPE_WEBHOOK_SECRET comes from the
# webhook endpoint you register for POST /api/webhooks/stripe (events:
# checkout.session.completed, invoice.payment_failed,
# invoice.payment_succeeded, customer.subscription.deleted) — `stripe
# listen --forward-to localhost:3000/api/webhooks/stripe` prints one for
# local dev.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""
STRIPE_PRICE_LIFETIME=""

# Web Push (RL-023 — notifications for a project's followers). Generate a
# key pair with `npx web-push generate-vapid-keys`. VAPID_PUBLIC_KEY and
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must be the SAME value — the public key
# needs both a server-side reader (src/lib/webpush.ts) and a
# client-exposed one (src/lib/pushClient.ts, which runs in the browser
# and can only read NEXT_PUBLIC_-prefixed vars). Without these set, push
# notifications silently no-op — email notifications to followers still
# work either way.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@riglog.ro"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Privacy contact (/privacy, /cookies). Whoever deploys this is the data
# controller, so these are NOT hardcoded — printing an address the
# operator doesn't monitor would be worse than printing none. When unset,
# the privacy page routes people to the feedback board instead, which
# always works; the export and delete buttons in settings work regardless.
# Set both before taking real users.
NEXT_PUBLIC_PRIVACY_CONTROLLER=""
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=""
