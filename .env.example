# Postgres (docker-compose.yml maps host 5434 -> container 5432, to avoid
# colliding with any other local Postgres instance)
DATABASE_URL="postgresql://postgres:pass@localhost:5434/riglog"

# Redis (rate limiting / background job locks)
REDIS_URL="redis://localhost:6380"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth (optional — email/password works without it)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (transactional email — password reset, document reminders, collaborator invites)
RESEND_API_KEY=""
EMAIL_FROM="RigLog <no-reply@riglog.ro>"

# Local file storage root for uploaded photos/receipts (served from /uploads)
UPLOADS_DIR="./public/uploads"

# Secret required in the x-cron-secret header to call
# POST /api/cron/document-reminders — no scheduler is wired up in this repo;
# point your platform's cron (Vercel Cron, a crontab, etc.) at it with this secret.
CRON_SECRET="replace-with-a-long-random-string"
