generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: the pooled connection string (e.g. Neon's PgBouncer
  // endpoint, or Vercel Postgres's default) — used at runtime by every
  // query the app makes. Serverless functions open a fresh connection per
  // invocation, so an unpooled connection exhausts a free-tier Postgres's
  // connection limit fast.
  url       = env("DATABASE_URL")
  // DIRECT_URL: the direct (unpooled) connection — Prisma automatically
  // uses this instead for `prisma migrate` (advisory locks and some DDL
  // don't work reliably through a pooler). Defaults to DATABASE_URL if
  // unset, which is fine for local dev against the docker-compose Postgres
  // (no pooler in front of it either way).
  directUrl = env("DIRECT_URL")
}

enum ProjectType {
  OFFROAD
  RESTORATION
  /// A car in regular use — a repair/maintenance log rather than a build
  /// with an end state. Gets the same tasks/photos/documents/costs as the
  /// other modes, but none of the project-only features (found state, VIN
  /// decoder, trail log, showcase cards).
  DAILY_DRIVER
}

enum WorkType {
  DIY
  WORKSHOP
}

enum AccountType {
  OWNER
  COLLABORATOR
}

enum CollaboratorRole {
  MECHANIC
  SPECIALIST
}

enum CollaboratorStatus {
  PENDING
  ACTIVE
  REMOVED
}

enum DocumentType {
  ITP
  RCA
  CASCO
  ROVINIETA
  FIRST_AID_KIT
  FIRE_EXTINGUISHER
  VIGNETTE
}

/// RL-017: which Stripe product got the user to isPro=true. MONTHLY/ANNUAL
/// are recurring Subscriptions; LIFETIME is a one-time Payment.
///
/// RL-042 (#54): MONTHLY/ANNUAL/LIFETIME are the plans sold before the
/// pricing ladder — no longer on sale, kept for the people who hold them
/// (grandfathered, uncapped; see src/lib/plans.ts). PERSONAL_* is what is
/// sold now.
enum ProPlan {
  MONTHLY
  ANNUAL
  LIFETIME
  PERSONAL_MONTHLY
  PERSONAL_ANNUAL
  PERSONAL_LIFETIME
}

/// A person who can log in. `accountType` distinguishes vehicle owners
/// (who may subscribe to Pro) from mechanic/specialist collaborators
/// (always free — see RL-030..033). Nothing currently reads
/// `accountType` for gating — it's descriptive metadata set at
/// registration, not itself an authorization check; `isPro` is what
/// actually gates Pro features, and a collaborator's own `isPro` is
/// irrelevant to what they can see (they inherit the vehicle owner's
/// tier — see the analytics page and CLAUDE.md).
model User {
  id                   String       @id @default(cuid())
  email                String       @unique
  password             String?
  displayName          String
  /// RL-018: stable public handle (`/builds/[username]/...`), distinct
  /// from `displayName` since that can contain spaces/unicode/duplicates.
  /// Generated once at signup (src/lib/username.ts) — never null for a
  /// user created after that ticket shipped; existing rows from before it
  /// are backfilled lazily the first time they publish a vehicle.
  username             String?      @unique
  location             String?
  avatarUrl            String?
  isPublicProfile      Boolean      @default(false)
  preferredMode        ProjectType?
  accountType          AccountType  @default(OWNER)
  /// Pro gates the RL-002 "1 vehicle free / unlimited Pro" limit, RL-014's
  /// PDF export, and RL-015's full analytics dashboard. Flipped only by
  /// the Stripe webhook (src/app/api/webhooks/stripe/route.ts) — never set
  /// directly from a client-facing route.
  isPro                Boolean      @default(false)
  /// Complimentary Pro, granted by an admin (beta testers, support
  /// goodwill, a contributor). Deliberately a *separate* column from
  /// `isPro` so the two owners never fight: Stripe owns `isPro` and will
  /// happily set it false on cancellation, which must not silently revoke
  /// a comp. Entitlement is `isPro || isProComped` — always read it
  /// through hasPro() in src/lib/pro.ts rather than testing either flag
  /// directly.
  isProComped          Boolean      @default(false)
  proCompedAt          DateTime?
  proCompedReason      String?
  /// The admin who granted it, kept for accountability. Not a relation:
  /// it must survive that admin's account being deleted. Null when the
  /// comp was granted automatically (the founding-member promotion).
  proCompedById        String?
  /// Founding-member position, 1..FOUNDING_MEMBER_LIMIT, for the first
  /// accounts ever created. Null for everyone after the promotion ran out
  /// and for accounts created before it existed. Unique, because two
  /// people cannot both be #7 — that constraint is the last line of
  /// defence if the allocator is ever changed carelessly.
  foundingNumber       Int?         @unique
  /// Moderates the public feedback board (src/app/tickets) — changing a
  /// ticket's status and replying as staff. Not a general-purpose admin
  /// role: it grants nothing over other users' vehicles or data, and is
  /// set directly in the database, never through an API route.
  isAdmin              Boolean      @default(false)
  /// Set once a Checkout session creates/reuses a Stripe Customer for this
  /// user — needed to open the Billing Portal (RL-017) and to resolve
  /// incoming webhook events back to a user.
  stripeCustomerId     String?      @unique
  /// Only set for MONTHLY/ANNUAL (a recurring Stripe Subscription).
  /// LIFETIME is a one-time Payment and has no subscription to track.
  stripeSubscriptionId String?      @unique
  proPlan              ProPlan?
  /// RL-042 (#54): held Pro before the pricing ladder — set by the
  /// migration for everyone with `isPro` or `isProComped` on that day, and
  /// never by a route. Such an account keeps Personal with no vehicle cap
  /// while it holds that old entitlement (`vehicleLimit()` in
  /// src/lib/plans.ts). Never cleared.
  grandfatheredAt      DateTime?
  /// Set by the webhook on `invoice.payment_failed`, cleared on the next
  /// `invoice.payment_succeeded` — drives the in-app failed-payment banner.
  /// isPro is left untouched here; Stripe's own retry schedule (and
  /// eventually `customer.subscription.deleted`) is what actually revokes
  /// access, not a single failed charge.
  proPaymentFailedAt   DateTime?
  /// RL-023: whether this user gets an email when a project they follow
  /// completes a task or adds photos. Both default on; either channel
  /// alone is a no-op if the user has no PushSubscription rows.
  notifyFollowedEmail  Boolean      @default(true)
  notifyFollowedPush   Boolean      @default(true)
  /// Language for anything this account is *sent*: reminder emails,
  /// invitations, follow notifications. The screen renders from the
  /// riglog-locale cookie instead (src/i18n/config.ts) — a cron job
  /// sending a document reminder at 3am has no browser to read a cookie
  /// from, so the preference has to live on the row as well. Null means
  /// the account predates the language chooser, or never used it; every
  /// reader coerces that to the default with toLocale().
  locale               String?
  /// When this address was proved to belong to whoever is using the
  /// account. Set at creation for a Google signup — the signIn callback
  /// already refuses an address Google itself reports as unverified — and
  /// only by clicking the emailed link for a password signup.
  ///
  /// Null means unverified, with one deliberate exception: accounts that
  /// existed before verification did were backfilled to their createdAt
  /// by the migration. They were never asked, and locking people out of a
  /// rule that did not exist when they joined is a worse wrong than a
  /// column that is optimistic about them.
  ///
  /// Nothing reads this directly — ask emailVerification.ts, which also
  /// knows that verification cannot be enforced on a deployment with no
  /// mail provider configured.
  emailVerifiedAt      DateTime?
  /// When the dashboard's getting-started checklist (RL-036) went away
  /// for good: dismissed by hand, or stamped the first time the dashboard
  /// saw every step done. Per account rather than per device, so somebody
  /// who has finished is not walked through it again on a second browser.
  /// Accounts that already had a logged job when this shipped were
  /// backfilled by the migration — they are past the point it helps with.
  onboardingClosedAt   DateTime?
  /// RL-038 closed beta: when an admin let this account create
  /// organisations. Null means it cannot create one (it can still be a
  /// member of one it was invited to). Switched on and off only through
  /// PATCH /api/admin/users/[userId]; turning it off stops new
  /// organisations and leaves existing ones alone.
  orgBetaAt            DateTime?
  active               Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  oauthAccounts        OAuthAccount[]
  passwordResetTokens  PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  vehicles             Vehicle[]
  tasksAdded           Task[]                @relation("TaskAddedBy")
  invitesSent          ProjectCollaborator[] @relation("InvitedBy")
  collaboratorOn       ProjectCollaborator[] @relation("CollaboratorUser")
  following            Follow[]              @relation("Follower")
  pushSubscriptions    PushSubscription[]
  partsRequests        PartsRequest[]
  partsRequestComments PartsRequestComment[]
  tickets              Ticket[]              @relation("TicketAuthor")
  odometerReadings     OdometerReading[]     @relation("OdometerReadingBy")
  fuelEntries          FuelEntry[]           @relation("FuelEntryBy")
  tyreSets             TyreSet[]             @relation("TyreSetBy")
  vehicleExpenses      VehicleExpense[]      @relation("VehicleExpenseBy")
  accidents            Accident[]            @relation("AccidentBy")
  organizationMemberships OrganizationMember[]
  organizationInvitesSent OrganizationInvite[] @relation("OrgInvitedBy")
  vehicleAssignments   VehicleAssignment[]   @relation("AssignmentDriver")
  assignmentsMade      VehicleAssignment[]   @relation("AssignmentBy")
  documentRenewals     DocumentRenewal[]     @relation("DocumentRenewedBy")
  tripsDriven          Trip[]                @relation("TripDriver")
  tripsLogged          Trip[]                @relation("TripBy")
  ticketVotes          TicketVote[]
  ticketComments       TicketComment[]
  donations            Donation[]
}

/// RL-023: a user following a public project. Notifications (email/push,
/// gated by the User-level toggles above) fire from
/// src/lib/followNotify.ts when a followed vehicle completes a task or
/// adds task photos.
model Follow {
  id             String   @id @default(cuid())
  vehicleId      String
  followerUserId String
  createdAt      DateTime @default(now())

  vehicle  Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  follower User    @relation("Follower", fields: [followerUserId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, followerUserId])
  @@index([vehicleId])
  @@index([followerUserId])
}

/// RL-023: one browser/device's Web Push subscription. A user can have
/// several (multiple devices); each is notified independently, and a
/// 404/410 response from the push service (src/lib/webpush.ts) means the
/// subscription is dead and the row should be deleted, not retried.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// RL-038: what a member of an organisation may do. OWNER runs the
/// organisation itself (details, members, deleting it); FLEET_MANAGER will
/// get the owner-only vehicle operations once company vehicles exist.
enum OrgRole {
  OWNER
  FLEET_MANAGER
  MECHANIC
  DRIVER
}

enum PartsRequestStatus {
  OPEN
  FOUND
}

/// RL-024: community parts crowdsourcing, Pro only (src/app/api/parts-requests/route.ts).
/// vehicleMake/vehicleModel are free text, not a relation to Vehicle — a
/// request is often about a car the requester hasn't (yet, or ever)
/// logged in RigLog. "Respond with a comment" (PartsRequestComment) is
/// implemented; "or a direct message" from the ticket is not — this repo
/// has no messaging/inbox system to hang that on, and building one was
/// out of scope here. See CLAUDE.md.
model PartsRequest {
  id                String             @id @default(cuid())
  userId            String
  vehicleMake       String
  vehicleModel      String
  partName          String
  partNumber        String?
  conditionAccepted String
  location          String
  description       String?
  status            PartsRequestStatus @default(OPEN)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments PartsRequestComment[]

  @@index([userId])
  @@index([status])
}

model PartsRequestComment {
  id             String   @id @default(cuid())
  partsRequestId String
  userId         String
  body           String
  createdAt      DateTime @default(now())

  partsRequest PartsRequest @relation(fields: [partsRequestId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([partsRequestId])
}

/// Links a Google-OAuth identity to a User, found-or-created by email at
/// sign-in (see src/lib/auth.ts) — not NextAuth's full Prisma adapter.
model OAuthAccount {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A single-use link proving the person registering can read the address
/// they typed. Shaped like PasswordResetToken on purpose — same lifecycle,
/// same cascade, same "spent tokens are marked rather than deleted" rule,
/// so there is one pattern to understand rather than two.
///
/// Longer-lived than a reset (24h vs 1h): a reset is something you asked
/// for and are waiting on, while this arrives in the middle of signing up
/// and is routinely opened the next morning.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One build (offroad) or restoration project. `projectType` is the
/// single config flag that drives category/status/photo-type vocabulary —
/// see src/lib/projectType.ts. Set at creation; the edit form does not
/// expose it as changeable once tasks exist.
model Vehicle {
  id                         String      @id @default(cuid())
  /// For a personal vehicle, its owner. For a company vehicle
  /// (`organizationId` set) only the account of record — whose storage
  /// prefix and plan it uses — and it grants **nothing** by itself: access
  /// comes from membership of the organisation (src/lib/access.ts).
  ownerId                    String
  /// RL-038: set when the vehicle belongs to an organisation. Restrict: an
  /// organisation with vehicles is not deleted by accident. A company
  /// vehicle is never public (a CHECK constraint in the migration).
  organizationId             String?
  projectType                ProjectType
  make                       String
  model                      String
  year                       Int
  generation                 String?
  engine                     String?
  vin                        String?
  /// RL-028 (Phase 4) — decoded factory spec, restoration mode only.
  /// Shape: { manufacturer, modelYear, factory, engineCode, bodyStyle,
  /// colorCode } (JSON, not a Vehicle column each, since some fields are
  /// only ever filled by the user's own manual entry and never by either
  /// decode path). colorCode is *always* user-supplied — no VIN decode
  /// path (local or NHTSA) can derive paint colour; there's no
  /// international standard encoding it in the VIN itself.
  vinDecoded                 Json?
  /// 'local' (Dacia/Renault-Romania WMI table) | 'nhtsa' (vPIC API) |
  /// 'manual' (user-entered fallback) — see src/lib/vinDecoder.ts.
  vinDecodeSource            String?
  coverPhotoUrl              String?
  isPublic                   Boolean     @default(false)
  /// RL-018: URL segment for the public page (`/builds/[username]/[slug]`)
  /// — unique per owner, not globally (see the compound index below).
  /// Generated at vehicle creation (src/lib/slug.ts); backfilled lazily if
  /// somehow still null when a vehicle is switched to public.
  slug                       String?
  /// RL-018: owner-controlled toggle — when true, the public page
  /// (visitors, not collaborators — see hideCostsFromCollaborators above)
  /// omits the total cost figure. Independent of that collaborator toggle.
  hidePublicCost             Boolean     @default(false)
  /// RL-031: owner-controlled toggle — when true, collaborators viewing
  /// this vehicle don't see cost totals (dashboard "Total spent" card,
  /// analytics page). Individual task cost fields are unaffected; this
  /// only gates the aggregate views. Owner and Pro-gating always see it.
  hideCostsFromCollaborators Boolean     @default(false)
  /// RL-050: identity and registration (src/lib/vehicleProfile.ts). All
  /// optional — a barn find has no plate. The plate is identifying and is
  /// never rendered on a public surface, like the raw VIN. Stored upper
  /// case with single spaces; searched with plateSearchKey().
  plate                      String?
  firstRegistrationDate      DateTime?
  /// A FUEL_TYPES code, labelled from the catalogue.
  fuelType                   String?
  /// A TRANSMISSIONS code, labelled from the catalogue.
  transmission               String?
  engineCapacityCc           Int?
  powerKw                    Int?
  colour                     String?
  seats                      Int?
  /// RL-050 values and finance, RL-045 slice 5 (src/lib/ownershipCosts.ts).
  /// The purchase lives here for every mode; a restoration's FoundState
  /// acquisitionDate/purchasePriceRon are mirrored both ways until a later
  /// release drops FoundState's copy (never rename and change behaviour in
  /// the same release).
  purchaseDate               DateTime?
  purchasePriceRon           Decimal?    @db.Decimal(10, 2)
  /// The owner's own estimate, dated. RigLog never computes a value — it
  /// has no valuation data, and an invented figure would end up in a sale.
  currentValueRon            Decimal?    @db.Decimal(10, 2)
  currentValueAt             DateTime?
  /// A FINANCE_TYPES code (LEASING | CREDIT); null means bought outright.
  financeType                String?
  financeMonthlyRon          Decimal?    @db.Decimal(10, 2)
  financeStartDate           DateTime?
  financeEndDate             DateTime?
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  owner         User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organization  Organization?         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tasks         Task[]
  workshops     Workshop[]
  wishlistItems WishlistItem[]
  collaborators ProjectCollaborator[]
  foundState    FoundState?
  documents     Document[]
  trailRuns     TrailRun[]
  followers     Follow[]
  odometerReadings OdometerReading[]
  fuelEntries   FuelEntry[]
  tyreSets      TyreSet[]
  expenses      VehicleExpense[]
  passportLinks PassportLink[]
  accidents     Accident[]
  assignments   VehicleAssignment[]
  trips         Trip[]

  @@unique([ownerId, slug])
  @@index([ownerId])
  @@index([organizationId])
  @@index([isPublic])
}

/// A modification (offroad) or restoration task/stage. `category`,
/// `status`, and TaskPhoto.photoType are free-form strings validated
/// against the vehicle's projectType config at write time, not Prisma
/// enums — the vocabulary differs per mode and is defined in one place
/// (src/lib/projectType.ts) rather than duplicated as DB enums.
model Task {
  id                   String   @id @default(cuid())
  vehicleId            String
  /// Nullable, and `onDelete: SetNull`, so a collaborator deleting their
  /// own account cannot take the vehicle owner's service history with
  /// them. Null means "added by an account that no longer exists" — the
  /// work still happened, only the attribution is gone. It was previously
  /// a required relation with Prisma's default `Restrict`, which made
  /// DELETE /api/me/account fail outright for anyone who had ever logged
  /// a task.
  addedByUserId        String?
  name                 String
  brand                String?
  category             String
  status               String
  workType             WorkType @default(DIY)
  costRon              Decimal? @db.Decimal(10, 2)
  partsCostRon         Decimal? @db.Decimal(10, 2)
  labourCostRon        Decimal? @db.Decimal(10, 2)
  date                 DateTime
  notes                String?
  workshopId           String?
  workshopName         String?
  workshopContact      String?
  supplierUrl          String?
  originalityCondition String?
  receiptUrl           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  vehicle  Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  addedBy  User?       @relation("TaskAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)
  workshop Workshop?   @relation(fields: [workshopId], references: [id])
  photos   TaskPhoto[]

  odometerReading OdometerReading?

  @@index([vehicleId])
  @@index([addedByUserId])
  @@index([workshopId])
}

/// Reusable per-vehicle workshop list (RL-029 autocomplete is scoped to
/// this, not a global directory — see CLAUDE.md pitfalls).
model Workshop {
  id         String   @id @default(cuid())
  vehicleId  String
  name       String
  contact    String?
  speciality String?
  location   String?
  notes      String?
  createdAt  DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([vehicleId])
}

model TaskPhoto {
  id        String   @id @default(cuid())
  taskId    String
  vehicleId String
  url       String
  caption   String?
  photoType String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([vehicleId])
}

/// 1:1 with a Vehicle, restoration mode only (RL-008). Off-road vehicles
/// never have one — always check vehicle.projectType before reading
/// vehicle.foundState.
model FoundState {
  id               String   @id @default(cuid())
  vehicleId        String   @unique
  acquisitionDate  DateTime
  purchasePriceRon Decimal? @db.Decimal(10, 2)
  odometer         Int?
  knownHistory     String?
  conditionRating  Int?
  frontNotes       String?
  rearNotes        String?
  leftNotes        String?
  rightNotes       String?
  roofNotes        String?
  floorNotes       String?
  engineNotes      String?
  interiorNotes    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vehicle Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  photos  FoundStatePhoto[]
}

model FoundStatePhoto {
  id           String   @id @default(cuid())
  foundStateId String
  url          String
  caption      String?
  createdAt    DateTime @default(now())

  foundState FoundState @relation(fields: [foundStateId], references: [id], onDelete: Cascade)

  @@index([foundStateId])
}

/// Wishlist (offroad) / parts hunt board (restoration) — RL-011/012.
model WishlistItem {
  id               String   @id @default(cuid())
  vehicleId        String
  name             String
  category         String?
  estimatedCostRon Decimal? @db.Decimal(10, 2)
  priority         Int      @default(0)
  status           String
  partCondition    String?
  supplierUrl      String?
  /// Supplier / source notes (RL-012) — free text, separate from supplierUrl.
  notes            String?
  hardToFind       Boolean  @default(false)
  /// RL-026 (Phase 4) — Pro-only price alert target. Automated daily
  /// scraping of supplierUrl was NOT built (legally grey per the ticket's
  /// own note, and this app has no scraping infra); instead the owner
  /// manually logs prices they've found via WishlistPriceEntry below, and
  /// a notification fires the first time a logged price is <= target.
  targetPriceRon   Decimal? @db.Decimal(10, 2)
  /// Set the first time a logged price triggers the alert; reset to null
  /// whenever targetPriceRon itself changes, so lowering/raising the
  /// target re-arms the alert (same idempotency pattern as
  /// Document.reminderNSentAt).
  priceAlertSentAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vehicle      Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  priceHistory WishlistPriceEntry[]

  @@index([vehicleId])
}

/// RL-026 (Phase 4) — a manually-logged "I found it at this price" entry,
/// the simpler alternative the ticket's own note recommends over
/// automated scraping. Powers the price-history chart on the wishlist
/// item detail page.
model WishlistPriceEntry {
  id             String   @id @default(cuid())
  wishlistItemId String
  priceRon       Decimal  @db.Decimal(10, 2)
  note           String?
  recordedAt     DateTime @default(now())

  wishlistItem WishlistItem @relation(fields: [wishlistItemId], references: [id], onDelete: Cascade)

  @@index([wishlistItemId])
}

/// Off-road only — RL-027 (Phase 4). GPS track recorded client-side via
/// the browser Geolocation API (foreground only — a PWA has no "always"
/// background location permission the way a native app does; recording
/// stops if the tab is backgrounded/closed, which is disclosed in the
/// recorder UI rather than silently losing data). trackGeoJson is an
/// array of {lat, lng, altitude?, timestamp} points, computed
/// client-side (src/lib/trailTrack.ts) into distanceKm/elevationGainM
/// before the run is saved; durationMin is tracked separately from
/// start/pause/resume/stop timestamps (not derived from track points),
/// so paused time is correctly excluded.
model TrailRun {
  id             String   @id @default(cuid())
  vehicleId      String
  name           String
  date           DateTime
  location       String?
  distanceKm     Decimal? @db.Decimal(6, 2)
  durationMin    Int?
  /// Null when no point in the track carried a usable altitude reading —
  /// common on devices/browsers that don't expose GPS altitude. Never
  /// estimated or defaulted to 0.
  elevationGainM Int?
  /// The recorded points. Rendered as a client-side SVG polyline
  /// thumbnail (src/components/TrailThumbnail.tsx) rather than a
  /// captured raster "map screenshot" — this stack has no static-maps
  /// API key (see the Leaflet/OSM substitution note on the map
  /// component), so the thumbnail is computed from this data instead of
  /// a separately stored image file.
  trackGeoJson   Json?
  notes          String?
  createdAt      DateTime @default(now())

  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  waypoints TrailWaypoint[]

  @@index([vehicleId])
}

/// A manually-dropped point during a trail run recording (RL-027) — a
/// note and/or photo at a specific spot, distinct from the continuous
/// GPS track itself.
model TrailWaypoint {
  id         String   @id @default(cuid())
  trailRunId String
  lat        Float
  lng        Float
  note       String?
  photoUrl   String?
  recordedAt DateTime
  createdAt  DateTime @default(now())

  trailRun TrailRun @relation(fields: [trailRunId], references: [id], onDelete: Cascade)

  @@index([trailRunId])
}

/// ITP/RCA/CASCO/Rovinieta reminders, both modes — RL-013. Reminders fire
/// at 30/14/7/3/1 days before expiryDate; the `reminderNSentAt` fields make
/// that idempotent across cron runs and reset to null whenever expiryDate
/// changes (see PATCH /api/vehicles/[id]/documents/[docId]) so renewing a
/// document re-arms every reminder.
model Document {
  id               String       @id @default(cuid())
  vehicleId        String
  type             DocumentType
  expiryDate       DateTime
  fileUrl          String?
  reminder30SentAt DateTime?
  reminder14SentAt DateTime?
  reminder7SentAt  DateTime?
  reminder3SentAt  DateTime?
  reminder1SentAt  DateTime?
  /// RL-045: what the policy/vignette cost, and the day it was paid —
  /// which is when it counts in the cost of ownership.
  costRon          Decimal?     @db.Decimal(10, 2)
  paidAt           DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  vehicle  Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  renewals DocumentRenewal[]

  @@index([vehicleId])
}

/// RL-041: a document is renewed in place — its expiry moves on — so the
/// expiry it had before is gone from the row. This keeps it, so a fleet
/// report can say what expired in a period and when it was renewed. Written
/// in the PATCH that moves the expiry later; a move earlier is a
/// correction, not a renewal, and is not recorded.
model DocumentRenewal {
  id              String   @id @default(cuid())
  documentId      String
  previousExpiry  DateTime
  newExpiry       DateTime
  renewedAt       DateTime @default(now())
  renewedByUserId String?

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  renewedBy User?    @relation("DocumentRenewedBy", fields: [renewedByUserId], references: [id], onDelete: SetNull)

  @@index([documentId, renewedAt])
  @@index([renewedByUserId])
}

/// Mechanic/specialist collaborator invite — RL-030/031/032. Invite
/// created PENDING by the owner (src/app/api/vehicles/[id]/collaborators/
/// route.ts), moves to ACTIVE when the invited email accepts
/// (src/app/api/collaborate/accept/route.ts), or REMOVED when the owner
/// revokes access. requireVehicleAccess() (src/lib/access.ts) grants
/// ACTIVE collaborators read/limited-write access on every vehicle route.
model ProjectCollaborator {
  id                 String             @id @default(cuid())
  vehicleId          String
  invitedByUserId    String
  collaboratorUserId String?
  email              String
  role               CollaboratorRole   @default(MECHANIC)
  label              String?
  status             CollaboratorStatus @default(PENDING)
  inviteToken        String             @unique
  invitedAt          DateTime           @default(now())
  acceptedAt         DateTime?

  vehicle          Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// Cascade: the inviter is always the vehicle's owner, so their account
  /// going away takes the vehicle and every invitation on it. Without a
  /// rule this defaulted to `Restrict` and blocked account deletion the
  /// same way Task.addedBy did.
  invitedBy        User    @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  /// Explicit, though SetNull is also Prisma's default for an optional
  /// relation: relying on an invisible default is what let Task.addedBy
  /// silently become `Restrict` and block account deletion entirely. The
  /// invitation row survives with no user attached, which never grants
  /// access — requireVehicleAccess() matches on a real id and null is not
  /// one.
  collaboratorUser User?   @relation("CollaboratorUser", fields: [collaboratorUserId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([collaboratorUserId])
}

// ---------------------------------------------------------------------------
// Public site: feedback board + donations
// ---------------------------------------------------------------------------

enum TicketType {
  BUG
  FEATURE
  IMPROVEMENT
}

/// OPEN is where every ticket starts. PLANNED/IN_PROGRESS/DONE track work
/// actually being done; DECLINED/DUPLICATE close a ticket without it. Only
/// an admin moves a ticket between these (see User.isAdmin) — the author
/// can edit their own text but never promote their own request to PLANNED.
enum TicketStatus {
  OPEN
  PLANNED
  IN_PROGRESS
  DONE
  DECLINED
  DUPLICATE
}

/// A public bug report / feature request. Readable by anyone (the board
/// doubles as a public roadmap); posting, voting and commenting all
/// require a session so votes can be attributed one-per-user.
model Ticket {
  id          String       @id @default(cuid())
  authorId    String
  type        TicketType
  status      TicketStatus @default(OPEN)
  title       String
  description String
  /// Set by an admin when closing as DECLINED/DUPLICATE, or to explain a
  /// status change on the ticket itself.
  adminNote   String?
  /// The build the reporter's browser was running, as *it* reported it —
  /// see sanitizeReportedVersion() in src/lib/version.ts.
  ///
  /// It comes from the request body, which is the only place it can come
  /// from: the server knows its own version, and on a PWA with a stale
  /// service-worker cache those two disagree. That disagreement is the
  /// whole point — "works on the current build" and "still broken here"
  /// are both true when somebody is three deploys behind.
  ///
  /// Untrusted, therefore, and shown to admins labelled as reported
  /// rather than as fact. Null for tickets opened before this existed, or
  /// by a client that did not send one.
  appVersion  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  author   User            @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  votes    TicketVote[]
  comments TicketComment[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

/// One vote per user per ticket. The @@unique is the actual guarantee —
/// the vote route relies on it rather than a read-then-write check, which
/// would race under concurrent requests and let one user vote twice.
model TicketVote {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@index([ticketId])
  @@index([userId])
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  body      String
  /// Marks a reply from the RigLog side so it reads differently in the
  /// thread. Set from the author's isAdmin at write time, not read live,
  /// so revoking admin later doesn't rewrite history.
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

enum DonationStatus {
  PENDING
  PAID
}

/// A one-off contribution via Stripe Checkout. `userId` is null for a
/// guest donation — donating deliberately doesn't require an account.
/// Rows are created PENDING when Checkout starts and only move to PAID
/// from the webhook, which is the single source of truth for payment
/// (same rule as User.isPro — a client reaching the success URL proves
/// nothing).
model Donation {
  id              String         @id @default(cuid())
  userId          String?
  /// Captured from Stripe at webhook time, so a guest donation still has
  /// something to attribute/receipt against.
  email           String?
  /// Stored in bani (RON minor units) to avoid float rounding, same
  /// reason costs are Decimal elsewhere.
  amountBani      Int
  currency        String         @default("ron")
  status          DonationStatus @default(PENDING)
  /// Optional public note shown on the supporters list.
  message         String?
  /// When true the supporters list shows "Anonymous" instead of a name.
  isAnonymous     Boolean        @default(false)
  /// Idempotency key for the webhook — a Stripe retry must not create or
  /// double-count a second donation row.
  stripeSessionId String         @unique
  createdAt       DateTime       @default(now())
  paidAt          DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
}

/// Fixed-window rate limit counter (src/lib/rateLimit.ts).
///
/// Backed by Postgres rather than an in-process Map because serverless
/// functions don't share memory — a counter in a module-level variable is
/// per-instance and resets on every cold start, so it bounds nothing. This
/// is also why the app doesn't rely on Vercel's WAF rate limiting: that's
/// a paid-plan feature and IP-only, and several of these limits need to be
/// per-account.
///
/// `key` encodes both the action and the subject ("login:ip:1.2.3.4",
/// "ticket:user:abc"). Rows for elapsed windows are dead weight and get
/// swept by the daily cron (src/app/api/cron/document-reminders/route.ts).
/// Allocation counter for the founding-member promotion — a single row.
///
/// Deliberately NOT `SELECT count(*) FROM "User"`: that reopens a slot
/// every time someone deletes their account, so "the first 100 users"
/// would quietly become "the first 100 users who are still here", and
/// slot #100 could be handed out repeatedly. This counter only ever goes
/// up.
///
/// Incremented by a single conditional UPDATE inside the same transaction
/// that creates the user (src/lib/foundingMembers.ts), so a registration
/// that fails does not burn a slot, and two concurrent registrations at 99
/// cannot both become #100.
model FoundingMemberCounter {
  /// Always 1. A one-row table, enforced by the primary key.
  id        Int      @id @default(1)
  taken     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

/// RL-044 slice 2 of #49: what the vehicle read, and when (src/lib/odometer.ts).
///
/// The vehicle's current mileage is **derived** from its newest reading and
/// never stored on Vehicle — a cached column drifts from its own history and
/// then nobody can tell which one lied.
///
/// Readings stay in date order: each must sit between the km of its date
/// neighbours. The genuine exceptions (a replaced instrument cluster, a
/// correction) are accepted as `isOverride` with an `overrideReason`, so a
/// history that jumps backwards can be explained rather than merely noticed.
/// An override starts a new segment; bounds are never checked across one.
model OdometerReading {
  id             String   @id @default(cuid())
  vehicleId      String
  km             Int
  /// The day the reading was taken, stored at 00:00 UTC.
  readAt         DateTime
  /// MANUAL | TASK | FOUND_STATE | FUEL | HANDOVER | TRIP — see ODOMETER_SOURCES.
  source         String
  note           String?
  isOverride     Boolean  @default(false)
  /// CLUSTER_REPLACED | CORRECTION, set exactly when isOverride is.
  overrideReason String?
  /// Set when the reading was logged with a job. SetNull, not Cascade:
  /// deleting the job does not unsay what the odometer read that day.
  taskId         String?  @unique
  /// SetNull like Task.addedBy: a collaborator deleting their account must
  /// not take the owner's mileage history with them.
  createdByUserId String?
  createdAt      DateTime @default(now())

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("OdometerReadingBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  fuelEntry FuelEntry?
  assignmentStart VehicleAssignment? @relation("AssignmentStart")
  assignmentEnd   VehicleAssignment? @relation("AssignmentEnd")
  tripStart       Trip?              @relation("TripStart")
  tripEnd         Trip?              @relation("TripEnd")

  @@index([vehicleId, readAt])
  @@index([createdByUserId])
}

/// RL-044 slice 3 of #49: a fill-up (src/lib/fuel.ts).
///
/// Only litres and the total are stored; the price per litre is derived
/// on display, so the three can never disagree. The km at the pump is an
/// OdometerReading (source FUEL) rather than a column here — one history
/// for mileage, per RL-044. Consumption is only ever computed between two
/// full tanks: a partial fill gives a figure that is simply wrong, and a
/// wrong l/100km is worse than a blank one because it gets quoted.
model FuelEntry {
  id                String   @id @default(cuid())
  vehicleId         String
  /// The day of the fill-up, stored at 00:00 UTC like OdometerReading.readAt.
  date              DateTime
  litres            Decimal  @db.Decimal(8, 2)
  totalRon          Decimal  @db.Decimal(10, 2)
  isFullTank        Boolean  @default(true)
  station           String?
  /// Storage key of the receipt, never a URL. collectStorageKeys() lists
  /// it, or the file would survive an erasure request (pitfall #14).
  receiptUrl        String?
  /// SetNull: removing the reading from the odometer history leaves the
  /// fill-up, which then simply stops counting towards consumption.
  odometerReadingId String?  @unique
  createdByUserId   String?
  createdAt         DateTime @default(now())

  vehicle         Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  odometerReading OdometerReading? @relation(fields: [odometerReadingId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("FuelEntryBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([vehicleId, date])
  @@index([createdByUserId])
}

/// RL-050 tyres, shipped with Car Health (RL-046) as slice 4 of #49 —
/// src/lib/vehicleHealth.ts reads them. A *set*, not a tyre: that is what
/// people buy, store and swap in Romania (summer/winter). At most one set
/// per vehicle is fitted; fitting one unfits the rest.
model TyreSet {
  id              String   @id @default(cuid())
  vehicleId       String
  /// SUMMER | WINTER | ALL_SEASON — see TYRE_SEASONS.
  season          String
  /// Brand and model as the owner writes it, e.g. "Michelin Alpin 6".
  label           String?
  /// As on the sidewall, e.g. "205/55 R16".
  size            String?
  /// Year from the DOT code — tyres age out even when the tread is fine.
  dotYear         Int?
  isFitted        Boolean  @default(false)
  fittedAt        DateTime?
  /// The odometer when it went on, for "km on this set". Not an
  /// OdometerReading: a fitting date is often estimated after the fact.
  fittedKm        Int?
  treadDepthMm    Decimal? @db.Decimal(3, 1)
  treadMeasuredAt DateTime?
  notes           String?
  /// RL-045: what the set cost and when it was bought.
  costRon         Decimal? @db.Decimal(10, 2)
  purchasedAt     DateTime?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("TyreSetBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([createdByUserId])
}

/// RL-045 (phase 5 slice 5): the long tail of what a vehicle costs that
/// has no better home — road tax, tolls, parking, washes, fines. Service
/// work stays on Task, fuel on FuelEntry, policies on Document and tyres on
/// TyreSet: cost lives on the thing it describes, and the cost of
/// ownership is a union over them (src/lib/ownershipCosts.ts).
model VehicleExpense {
  id              String   @id @default(cuid())
  vehicleId       String
  /// The day it was paid, stored at 00:00 UTC.
  date            DateTime
  /// An EXPENSE_KINDS code.
  kind            String
  amountRon       Decimal  @db.Decimal(10, 2)
  note            String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("VehicleExpenseBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([vehicleId, date])
  @@index([createdByUserId])
}

/// RL-049 (phase 5 slice 7): a share link to the vehicle passport — the
/// owner's own records, readable without an account at /passport/<token>.
/// Revoking sets revokedAt; the page then answers "withdrawn", never the
/// data. What the plate and VIN are, and whether costs show, is chosen per
/// link: both are identifying and off by default (RL-050).
model PassportLink {
  id        String    @id @default(cuid())
  vehicleId String
  /// 32 random bytes, base64url. The only thing that grants access.
  token     String    @unique
  showPlate Boolean   @default(false)
  showVin   Boolean   @default(false)
  showCosts Boolean   @default(true)
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

/// RL-050 accidents and damage (slice 8 of #49, src/lib/accidents.ts). What
/// happened, as the owner records it: a collision, a parking scrape, hail.
/// The passport lists these as records, and with none it says "none
/// recorded in RigLog", never that the vehicle has had none.
model Accident {
  id              String    @id @default(cuid())
  vehicleId       String
  /// The day it happened, stored at 00:00 UTC.
  date            DateTime
  /// An ACCIDENT_KINDS code.
  kind            String
  description     String
  /// The odometer at the time, if known. Not an OdometerReading: damage
  /// found later has a guessed date, which must not bound the history.
  km              Int?
  /// An INSURANCE_ROUTES code (NONE | RCA | CASCO); null means not recorded.
  insurance       String?
  /// What the repair cost, as the owner knows it. Not in the cost of
  /// ownership: the repair is a job, and jobs already count (MONEY_COLUMNS).
  repairCostRon   Decimal?  @db.Decimal(10, 2)
  /// When it was repaired; null means not repaired, or not recorded.
  repairedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("AccidentBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  photos    AccidentPhoto[]

  @@index([vehicleId, date])
  @@index([createdByUserId])
}

/// A photo of the damage or the repair. `url` is a storage key under the
/// vehicle owner's prefix, listed in collectStorageKeys() (pitfall #14).
model AccidentPhoto {
  id         String   @id @default(cuid())
  accidentId String
  url        String
  createdAt  DateTime @default(now())

  accident Accident @relation(fields: [accidentId], references: [id], onDelete: Cascade)

  @@index([accidentId])
}

/// RL-038: a company that owns vehicles (from a later slice) and has
/// members. `cui` is the Romanian fiscal code, stored normalised (see
/// src/lib/organizations.ts), optional because a company may be set up
/// before its papers are to hand.
/// RL-042 (#54) slice 3: the company rungs of the ladder, each monthly or
/// annual; Fleet in its fixed steps. Prices and allowances in src/lib/plans.ts.
enum OrgPlan {
  PRO_MONTHLY
  PRO_ANNUAL
  BUSINESS_MONTHLY
  BUSINESS_ANNUAL
  FLEET_100_MONTHLY
  FLEET_100_ANNUAL
  FLEET_250_MONTHLY
  FLEET_250_ANNUAL
  FLEET_500_MONTHLY
  FLEET_500_ANNUAL
}

model Organization {
  id             String   @id @default(cuid())
  name           String
  cui            String?
  billingAddress String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  /// RL-042 (#54) slice 3: the organisation's own Stripe customer — never a
  /// member's, so a card is the company's and outlives who added it.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  /// The company plan paid for, written only by the Stripe webhook. Null
  /// with no subscription; read through `orgVehicleLimit()`.
  plan                 OrgPlan?
  /// Set on `invoice.payment_failed`, cleared on the next success — the
  /// banner. The plan itself only ends on `customer.subscription.deleted`.
  paymentFailedAt      DateTime?
  /// No charge and no vehicle cap: every organisation from the closed beta
  /// (stamped by the migration), and one created by a beta account while
  /// organisation billing is not configured yet.
  compedAt             DateTime?

  members  OrganizationMember[]
  invites  OrganizationInvite[]
  vehicles Vehicle[]
}

/// One account's place in one organisation. Deleting the account removes
/// the membership and nothing else; the last OWNER cannot leave or be
/// demoted (checked under a lock on the organisation row).
model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

/// RL-038 slice 2: an emailed invitation to join an organisation with a
/// role. Only a SHA-256 of the token is stored, so a copy of the database
/// cannot be used to join anything. Accepting needs a session whose email
/// is the invited one; the link lasts INVITE_EXPIRY_DAYS from `invitedAt`
/// (a resend issues a new token and restarts it).
model OrganizationInvite {
  id              String    @id @default(cuid())
  organizationId  String
  email           String
  role            OrgRole
  tokenHash       String    @unique
  invitedByUserId String?
  invitedAt       DateTime  @default(now())
  acceptedAt      DateTime?
  revokedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// SetNull: an owner deleting their account must not withdraw every
  /// invitation they sent on the organisation's behalf.
  invitedBy    User?        @relation("OrgInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([invitedByUserId])
}

/// RL-040: who drives a company vehicle, as a history — "who had the van in
/// March" is a query, not a guess. An assignment starts when it is made and
/// ends when it is ended; neither is back-dated, so ranges cannot overlap
/// and **one active driver per vehicle** is a partial unique index
/// (`endedAt IS NULL`) in the migration, not a check in the form.
model VehicleAssignment {
  id            String    @id @default(cuid())
  vehicleId     String
  driverUserId  String
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  note          String?
  assignedByUserId String?
  /// Handover (slice 2): the km at each end, as OdometerReadings (source
  /// HANDOVER) in the vehicle's one mileage history. SetNull: deleting a
  /// reading by hand does not unmake the assignment.
  startReadingId String?  @unique
  endReadingId   String?  @unique
  createdAt     DateTime  @default(now())

  vehicle    Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  startReading OdometerReading? @relation("AssignmentStart", fields: [startReadingId], references: [id], onDelete: SetNull)
  endReading   OdometerReading? @relation("AssignmentEnd", fields: [endReadingId], references: [id], onDelete: SetNull)
  photos     AssignmentPhoto[]
  /// Cascade: a driver deleting their account takes their assignment
  /// history with it; the vehicle's own log is untouched.
  driver     User    @relation("AssignmentDriver", fields: [driverUserId], references: [id], onDelete: Cascade)
  assignedBy User?   @relation("AssignmentBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([vehicleId, startedAt])
  @@index([driverUserId])
  @@index([assignedByUserId])
}

/// RL-040 handover: condition photos taken at either end of an assignment.
/// Evidence, so neither the driver nor a manager deletes one; they go with
/// the assignment (and the vehicle). Filed under the vehicle owner's prefix
/// like every other upload, and listed in collectStorageKeys().
model AssignmentPhoto {
  id           String   @id @default(cuid())
  assignmentId String
  /// START | END
  stage        String
  url          String
  createdAt    DateTime @default(now())

  assignment VehicleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
}

/// RL-051: a trip for the trip sheet (foaie de parcurs). The distance is
/// never stored: the two ends are OdometerReadings (source TRIP) in the
/// vehicle's one mileage history, written with the trip. SetNull on them,
/// like a fill-up's: deleting a reading by hand leaves the trip without a
/// distance rather than deleting it.
model Trip {
  id              String   @id @default(cuid())
  vehicleId       String
  /// SetNull: a driver deleting their account does not take the company's
  /// trip sheets with them; `driverName` keeps the sheet readable.
  driverUserId    String?
  driverName      String
  /// The day of the trip, stored at 00:00 UTC.
  date            DateTime
  fromPlace       String
  toPlace         String
  purpose         String?
  /// BUSINESS | PERSONAL — see TRIP_KINDS. The split is the fiscal point.
  kind            String
  startReadingId  String?  @unique
  endReadingId    String?  @unique
  createdByUserId String?
  createdAt       DateTime @default(now())

  vehicle      Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver       User?            @relation("TripDriver", fields: [driverUserId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("TripBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  startReading OdometerReading? @relation("TripStart", fields: [startReadingId], references: [id], onDelete: SetNull)
  endReading   OdometerReading? @relation("TripEnd", fields: [endReadingId], references: [id], onDelete: SetNull)

  @@index([vehicleId, date])
  @@index([driverUserId, date])
  @@index([createdByUserId])
}
